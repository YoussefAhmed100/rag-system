APP_NAME=RAG System
APP_VERSION=1.0.0

OPENAI_API_KEY=your_openai_api_key_here

FILE_ALLOWED_TYPES=["application/pdf","text/plain","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=1048576

# Database configuration
MONGODB_URL=mongodb://rag_admin:ChangeThisMongoPassword123@mongodb:27017/?authSource=admin
MONGODB_DATABASE=rag_system

MONGO_INITDB_ROOT_USERNAME=rag_admin
MONGO_INITDB_ROOT_PASSWORD=admin123

MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin123
